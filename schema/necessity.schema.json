{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hippoley/Residual-Necessity/schema/necessity.schema.json",
  "title": "Residual Necessity Receipt",
  "type": "object",
  "required": ["schema_version", "intervention", "target", "predicates", "observations"],
  "$defs": {
    "authority": {
      "type": "object",
      "required": ["scope", "basis", "evidence_ref"],
      "properties": {
        "scope": {
          "type": "object",
          "required": ["predicate_id", "target_identity"],
          "properties": {
            "predicate_id": {"type": "string", "minLength": 1},
            "target_identity": {"type": "string", "minLength": 1},
            "target_revision": {"type": "string"}
          },
          "additionalProperties": false
        },
        "basis": {"type": "string", "minLength": 1},
        "evidence_ref": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "properties": {
    "schema_version": {"const": "0.2"},
    "intervention": {
      "type": "object",
      "required": ["id", "kind", "description", "justified_by"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "justified_by": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": true
    },
    "target": {
      "type": "object",
      "required": ["identity", "revision"],
      "properties": {
        "identity": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "environment": {"type": "object"}
      },
      "additionalProperties": true
    },
    "predicates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "required", "kind"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "kind": {"enum": ["reality", "freshness", "scope", "authority"]},
          "human_only": {"type": "boolean", "default": false}
        },
        "additionalProperties": true
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {"enum": ["TRUE", "FALSE", "UNKNOWN", "CONFLICTED", "STALE"]},
          "source": {"type": "string"},
          "observed_at": {"type": "string"},
          "positive_authority": {"$ref": "#/$defs/authority"},
          "negative_authority": {"$ref": "#/$defs/authority"},
          "details": {}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
