{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hippoley/Residual-Necessity/benchmark/method_submission.schema.json",
  "title": "Residual Necessity Benchmark Method Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "method_id",
    "track_id",
    "code_commit",
    "provider_profile_sha256",
    "development_report_sha256",
    "holdout_status",
    "dependencies",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": "rn-method-card/0.1"
    },
    "method_id": {
      "type": "string",
      "minLength": 1
    },
    "track_id": {
      "const": "A-runtime-necessity"
    },
    "code_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "provider_profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "development_report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prediction_protocol": {
      "const": "freeze_before_holdout_reveal"
    },
    "holdout_status": {
      "enum": [
        "sealed",
        "released"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version_or_commit"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version_or_commit": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          },
          "purpose": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intended_claim",
        "non_claims"
      ],
      "properties": {
        "intended_claim": {
          "type": "string",
          "minLength": 1
        },
        "non_claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "development_metrics": {
      "type": "object",
      "additionalProperties": true
    },
    "holdout_release_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "holdout_status": {
            "const": "sealed"
          }
        }
      },
      "then": {
        "properties": {
          "holdout_release_commit": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "holdout_status": {
            "const": "released"
          }
        }
      },
      "then": {
        "required": [
          "holdout_release_commit"
        ],
        "properties": {
          "holdout_release_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    }
  ]
}
